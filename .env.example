# ──────────────────────────────────────────────────────────────
# Environment template — copy to .env.local and fill what you need:
#     cp .env.example .env.local
#
# Only NEXT_PUBLIC_* values reach the browser; everything else stays
# server-side. .env.local is gitignored — never commit real secrets.
# Every value below is OPTIONAL: the site builds and runs without any
# of them (sensible localhost/in-memory fallbacks kick in).
# ──────────────────────────────────────────────────────────────

# ── Site ───────────────────────────────────────────────────────
# Canonical origin for metadata, canonical URLs, OG images,
# sitemap.xml and robots.txt. Set this to your production domain.
# On Vercel, VERCEL_URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Search-engine verification (SEO) ───────────────────────────
# Rendered into <head> only when set. Get the token from each console:
#   Google → https://search.google.com/search-console
#   Bing   → https://www.bing.com/webmasters   (the msvalidate.01 value)
#   Yandex → https://webmaster.yandex.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ── GitHub ─────────────────────────────────────────────────────
# Raises GitHub REST rate limits for the live Projects feed.
# A fine-grained token with public read access is enough.
GITHUB_TOKEN=

# ── Terminal section / AI (Groq) ───────────────────────────────
# Powers the interactive terminal. Without GROQ_API_KEY the AI replies
# are disabled; the rest of the site is unaffected.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Bearer key required to call /api/terminal in production.
TERMINAL_API_KEY=

# ── Rate limiting (Upstash Redis) ──────────────────────────────
# Used for API rate limiting; falls back to in-memory when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── On-demand revalidation ─────────────────────────────────────
# Shared secret for POST /api/revalidate (cache-busting webhook).
REVALIDATE_SECRET=
